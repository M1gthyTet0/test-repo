# PostgreSQL (Neon / Vercel Postgres)
POSTGRES_URL="postgres://user:password@host/dbname?sslmode=require"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Google Gemini API
GENAI_G_API_KEY="AIza..."
GEMINI_MODEL="gemini-3.8-flash"

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."

# Teléfonos autorizados de Norma (separados por coma, formato E.164 con prefijo whatsapp:)
NORMA_PHONE_WHITELIST="whatsapp:+5491112345678"

# Opcionales para el catálogo público y respuestas del bot
NEXT_PUBLIC_WHATSAPP_NUMBER="+5491112345678"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SANDBOX_KEYWORD="DEMO"

# Telegram Bot (alternativa sin límites de mensajes ni bloqueo de media)
TELEGRAM_BOT_TOKEN="123456:ABC..."

# Contraseña para el panel de administración (/admin)
ADMIN_PASSWORD="cambia-esta-clave"

# Meta WhatsApp Cloud API (alternativa oficial gratuita con soporte de media)
META_VERIFY_TOKEN="norma-meta-verify"
META_ACCESS_TOKEN="EAAG..."
META_PHONE_NUMBER_ID="123456789012345"
